# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="FaceFind Drive"
APP_ENV=development              # development | production
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_CHARS_MIN
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./facefind.db

# ─── Google Drive ────────────────────────────────────────────────────────────
# Path to your service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account/credentials.json
# The Drive folder ID the admin has shared with the service account
DRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID_HERE

# ─── Gemini Vision (Face Recognition) ───────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Model options: gemini-1.5-flash (fast, cheap) | gemini-1.5-pro (best accuracy) | gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash
# Confidence threshold: 0.0 (any match) → 1.0 (identical). Default: 0.68
FACE_SIMILARITY_THRESHOLD=0.68

# ─── Indexer / Scheduler ─────────────────────────────────────────────────────
# How often to re-index the Drive folder (in hours)
INDEX_INTERVAL_HOURS=6
# Max images to download concurrently during indexing
INDEX_CONCURRENCY=4

# ─── CORS ────────────────────────────────────────────────────────────────────
# Your deployed frontend URL (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.netlify.app

# ─── Audit ───────────────────────────────────────────────────────────────────
AUDIT_LOG_FILE=./logs/audit.jsonl

# ─── App Purpose (shown to users in consent banner) ──────────────────────────
STATED_PURPOSE=Event Photo Retrieval — MIT 2024
